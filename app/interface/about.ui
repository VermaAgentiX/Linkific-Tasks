   <property name="html">
    <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;meta charset=&quot;utf-8&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
hr { height: 1px; border-width: 0; }
li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Segoe UI'; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;h1 style=&quot; margin-top:18px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:xx-large; font-weight:700; color:#828fb9;&quot;&gt;About Finance Flow&lt;/span&gt;&lt;/h1&gt;
&lt;h2 style=&quot; margin-top:16px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:x-large; font-weight:700; color:#8390ba;&quot;&gt;Overview&lt;/span&gt;&lt;/h2&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt; color:#000000;&quot;&gt;Welcome to &lt;/span&gt;&lt;span style=&quot; font-size:11pt; font-weight:700; color:#8390ba;&quot;&gt;Finance Flow&lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#000000;&quot;&gt; – your ultimate companion for managing and tracking personal expenses effortlessly. Designed with simplicity and functionality in mind, Finance Flow helps you keep a detailed record of your spending, visualize your financial health, and make informed decisions about your money.&lt;/span&gt;&lt;/p&gt;
&lt;h2 style=&quot; margin-top:16px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:x-large; font-weight:700; color:#8390ba;&quot;&gt;Features&lt;/span&gt;&lt;/h2&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;
&lt;li style=&quot; margin-top:12px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt; font-weight:700; color:#8390ba;&quot;&gt;Expense Tracking&lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#000000;&quot;&gt;: Easily enter and categorize your expenses. Record details about the purpose, recipient, and amount spent.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-size:11pt; color:#000000;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:700; color:#8390ba;&quot;&gt;Notes and Data Entry&lt;/span&gt;&lt;span style=&quot; color:#8390ba;&quot;&gt;:&lt;/span&gt; Add insightful notes to each entry for better tracking and future reference.&lt;/li&gt;
&lt;li style=&quot; font-size:11pt; color:#000000;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:700; color:#8390ba;&quot;&gt;Data Visualization&lt;/span&gt;&lt;span style=&quot; color:#8390ba;&quot;&gt;:&lt;/span&gt; Visualize your financial data with interactive bar plots using pyqtgraph, helping you understand your remaining income and overall spending patterns.&lt;/li&gt;
&lt;li style=&quot; font-size:11pt; color:#000000;&quot; style=&quot; margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:700; color:#8390ba;&quot;&gt;Customizable Tables&lt;/span&gt;&lt;span style=&quot; color:#8390ba;&quot;&gt;:&lt;/span&gt; Manage and review your data with user-friendly tables that adapt to your needs.&lt;/li&gt;&lt;/ul&gt;
&lt;h2 style=&quot; margin-top:16px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:x-large; font-weight:700; color:#828fb9;&quot;&gt;Why Choose Finance Flow?&lt;/span&gt;&lt;/h2&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;
&lt;li style=&quot; margin-top:12px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt; font-weight:700; color:#8390ba;&quot;&gt;Intuitive Interface&lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#8390ba;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#000000;&quot;&gt; Designed with user experience in mind, Finance Flow makes it easy to navigate and manage your finances without hassle.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-size:11pt; color:#000000;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:700; color:#8390ba;&quot;&gt;Comprehensive Tracking&lt;/span&gt;&lt;span style=&quot; color:#8390ba;&quot;&gt;:&lt;/span&gt; From daily expenses to long-term spending habits, Finance Flow gives you a complete overview of your financial situation.&lt;/li&gt;
&lt;li style=&quot; font-size:11pt; color:#000000;&quot; style=&quot; margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:700; color:#828fb9;&quot;&gt;Visual Insights&lt;/span&gt;&lt;span style=&quot; color:#828fb9;&quot;&gt;:&lt;/span&gt; Leverage powerful visualizations to quickly grasp your financial status and make proactive decisions.&lt;/li&gt;&lt;/ul&gt;
&lt;h2 style=&quot; margin-top:16px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:x-large; font-weight:700; color:#8390ba;&quot;&gt;Version&lt;/span&gt;&lt;/h2&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;
&lt;li style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt; font-weight:700; color:#8390ba;&quot;&gt;Current Version&lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#8390ba;&quot;&gt;: 1.1&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;
&lt;h2 style=&quot; margin-top:16px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:x-large; font-weight:700; color:#8390ba;&quot;&gt;Developer Information&lt;/span&gt;&lt;/h2&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt; font-weight:700; color:#8390ba;&quot;&gt;Finance Flow&lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#000000;&quot;&gt; is developed by &lt;/span&gt;&lt;span style=&quot; font-size:11pt; font-weight:700; color:#828fb9;&quot;&gt;Abhishek Verma&lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#828fb9;&quot;&gt;,&lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#000000;&quot;&gt; a Btech graduate and software engineer currently working in the field of Software development and Machine learning. He is dedicated to creating practical solutions that simplify everyday tasks and enhance user experience.&lt;/span&gt;&lt;/p&gt;
&lt;h2 style=&quot; margin-top:16px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:x-large; font-weight:700; color:#8390ba;&quot;&gt;How It Works&lt;/span&gt;&lt;/h2&gt;
&lt;ol style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;
&lt;li style=&quot; margin-top:12px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt; font-weight:700; color:#8390ba;&quot;&gt;Data Entry&lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#8390ba;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot; font-size:11pt; color:#000000;&quot;&gt; Input your expense data including categories, purposes, and recipients.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-size:11pt; color:#000000;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:700; color:#7986ac;&quot;&gt;Organize &amp;amp; Analyze&lt;/span&gt;&lt;span style=&quot; color:#7986ac;&quot;&gt;:&lt;/span&gt; Use the built-in tables to organize your entries and add notes for better tracking.&lt;/li&gt;
&lt;li style=&quot; font-size:11pt; color:#000000;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:700; color:#7986ac;&quot;&gt;Visualize&lt;/span&gt;&lt;span style=&quot; color:#7986ac;&quot;&gt;:&lt;/span&gt; Review your remaining income and spending patterns through interactive graphs.&lt;/li&gt;
&lt;li style=&quot; font-size:11pt; color:#000000;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:700; color:#7885ab;&quot;&gt;Manage&lt;/span&gt;&lt;span style=&quot; color:#7885ab;&quot;&gt;:&lt;/span&gt; Edit, update, or delete entries as needed to keep your records accurate and up-to-date.&lt;/li&gt;
&lt;li style=&quot; font-size:11pt; color:#000000;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:700; color:#7986ac;&quot;&gt;Calculator&lt;/span&gt;&lt;span style=&quot; color:#7986ac;&quot;&gt;:&lt;/span&gt; calculate datas easily using keyboard input, just type expressions.&lt;/li&gt;
&lt;li style=&quot; font-size:11pt; color:#000000;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:700; color:#7986ac;&quot;&gt;Calender&lt;/span&gt;&lt;span style=&quot; color:#7986ac;&quot;&gt;:&lt;/span&gt; calender is present in the same window.&lt;/li&gt;&lt;/ol&gt;
&lt;h2 style=&quot; margin-top:16px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:x-large; font-weight:700; color:#828fb9;&quot;&gt;Support&lt;/span&gt;&lt;/h2&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt; color:#000000;&quot;&gt;If you have any questions or need assistance with Finance Flow, please reach out to our support team at support at abhishek639679@gmail.com . We're here to help!&lt;/span&gt;&lt;/p&gt;
&lt;h2 style=&quot; margin-top:16px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:x-large; font-weight:700; color:#828fb9;&quot;&gt;Feedback&lt;/span&gt;&lt;/h2&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt; color:#000000;&quot;&gt;We value your feedback! Share your thoughts or suggestions with us at abhishek639679@gmail.com to help us improve and enhance your experience.&lt;/span&gt;&lt;/p&gt;
&lt;h2 style=&quot; margin-top:16px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:x-large; font-weight:700; color:#808db6;&quot;&gt;Connect with Us&lt;/span&gt;&lt;/h2&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:11pt; color:#000000;&quot;&gt;Follow us on social media to stay updated on the latest news, updates, and tips related to Finance Flow:&lt;/span&gt;&lt;/p&gt;
