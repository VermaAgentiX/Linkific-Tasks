    selection-background-color: #3a7bd5; /* Highlight text selection in blue */

}

#lineEdit_item_quantity_input:hover {
    border: 1px solid #3a7bd5;  /* Professional blue on hover */
    background-color: #f0f4ff;  /* Slightly lighter background */
}

#lineEdit_item_quantity_input:focus {
    border: 1px solid #2bb673;  /* Elegant green focus */
    background-color: #ffffff;  /* Crisp white for focus */
    color: #000000;
}
</string>
