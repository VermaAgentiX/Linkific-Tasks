              <item>
               <widget class="QCalendarWidget" name="calendarWidget">
                <property name="minimumSize">
                 <size>
                  <width>0</width>
                  <height>0</height>
                 </size>
                </property>
                <property name="styleSheet">
                 <string notr="true">/* ==========================
   QCalendarWidget - Professional Soft Blue Theme
   ========================== */

/* Overall calendar */
QCalendarWidget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f2f5fb, stop:1 #dce4f2);
    border: 1px solid #a7b4d0;
    
    font: 10pt &quot;Segoe UI&quot;;
    color: #1f2937;
    selection-background-color: #5e85d7;
    selection-color: white;
}

/* Navigation bar (Month &amp; Year area) */
QCalendarWidget QToolButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #d4def3, stop:1 #b8c6e0);
    color: #1e2b4f;
    font: bold 10pt &quot;Segoe UI&quot;;
    border: 1px solid #9eaed3;
    border-radius: 6px;
    
}

QCalendarWidget QToolButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #7ea2f7, stop:1 #5e85d7);
    color: white;
}



/* Dropdown popup (month/year menu) */
QCalendarWidget QMenu {
    background-color: #f9fbff;
    border: 1px solid #a7b4d0;
    border-radius: 6px;
    font: 10pt &quot;Segoe UI&quot;;
    color: #1f2937;
}

QCalendarWidget QMenu::item {

    border-radius: 4px;
}

QCalendarWidget QMenu::item:selected {
    background-color: #8caefb;  /* Light blue highlight */
    color: white;
}

QCalendarWidget QMenu::item:hover {
    background-color: #dbe6ff;  /* Soft hover blue */
    color: #1f2937;
}

/* Header row (days of the week) */
QCalendarWidget QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #b8c6e0, stop:1 #a7b4d0);
    color: #1f2937;
    font-weight: 600;
    border: none;

}

/* Days grid */
QCalendarWidget QAbstractItemView {
    background: #f7f9fc;
    alternate-background-color: #edf2f7;
    border: none;
    color: #1f2937;
    gridline-color: #cfd9ec;
    outline: none;
}

/* Day hover */
QCalendarWidget QAbstractItemView::item:hover {
    background-color: #dbe6ff;
    color: #000000;
    border-radius: 4px;
}

/* Selected date */
QCalendarWidget QAbstractItemView::item:selected {
    background-color: #5e85d7;
    color: white;
    border-radius: 4px;
}

/* Highlight today’s date */
QCalendarWidget QTableView::item:focus {
    border: 1px solid #5e85d7;
}

/* Different color for weekends */
QCalendarWidget QWidget#qt_calendar_calendarview QTableView::item {
    
    border-radius: 4px;
}

QCalendarWidget QWidget#qt_calendar_calendarview QTableView::item:enabled {
    color: #1e1e1e;
}

QCalendarWidget QWidget#qt_calendar_calendarview QTableView::item:enabled:!active {
    color: #1e1e1e;
}

QCalendarWidget QWidget#qt_calendar_calendarview QTableView::item:enabled:selected {
    color: white;
}

/* Spinbox (year selector) */
QCalendarWidget QSpinBox {
    background: #edf2f7;
    color: #1f2937;
    border: 1px solid #a7b4d0;
    border-radius: 6px;
 
    font: 10pt &quot;Segoe UI&quot;;
}

QCalendarWidget QSpinBox::up-button,
QCalendarWidget QSpinBox::down-button {
    background: #c5d2ed;
    border: none;
    border-radius: 3px;
    width: 16px;
}

QCalendarWidget QSpinBox::up-button:hover,
QCalendarWidget QSpinBox::down-button:hover {
    background: #8caefb;
}
</string>
                </property>
                <property name="firstDayOfWeek">
                 <enum>Qt::DayOfWeek::Monday</enum>
                </property>
                <property name="gridVisible">
                 <bool>true</bool>
                </property>
                <property name="selectionMode">
                 <enum>QCalendarWidget::SelectionMode::SingleSelection</enum>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
