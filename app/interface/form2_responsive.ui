          <property name="styleSheet">
           <string notr="true">/* Main Tab Widget */
#tabWidget_3::pane {
    
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #edf2f7, stop:1 #dce4f2);
   
   
    
}

/* Tabs - neutral background, rounded, soft hover */
#tabWidget_3 QTabBar::tab {
        background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #7287ca, stop:1 #5f71a8);
    color: white;
    padding: 4px 10px;
    margin-right: 6px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    font: 11pt &quot;Segoe UI&quot;;
    
    min-width: 100px;
    border: 1px solid #7287ca;
    border-bottom: none;


   
}

/* Selected tab - highlighted cleanly with shadow and bolder color */
#tabWidget_3 QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #a6c8ff, stop:1 #94b2e3);
    color: #445178;
    border: 1px solid #96b4e6;
border-bottom: 1px solid #96b4e6;;
    font-weight: 600;

   
}

/* Hover (for non-selected tabs) - subtle lightening */
#tabWidget_3 QTabBar::tab:hover:!selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #7c9bf1, stop:1 #7c9bf1);
    color: white;
    border: 1px solid #7c9bf1;
}

/* TabBar base */
#tabWidget_3 QTabBar {
    qproperty-drawBase: 0;
  
}



</string>
