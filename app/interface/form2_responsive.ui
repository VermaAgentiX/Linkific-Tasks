                       <property name="styleSheet">
                        <string notr="true">QToolButton {


    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ebebeb, stop:1 #ffffff);
    color: black;
    border: none;
        border: 1px solid #7986ac;
    border-radius: 4px;
   
    
}

QToolButton:hover {
     background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff, stop:1 #ffffff);
}

QToolButton:pressed {
 

    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f4f6fb, stop:1 #cbcbcb);
color: black;
  
}

QToolButton:disabled {
    background: #475569;
    color: #94a3b8;
}</string>
