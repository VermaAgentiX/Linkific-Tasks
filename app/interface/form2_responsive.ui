                     <property name="styleSheet">
                      <string notr="true">/* ===== Table Widget Style (Light Blue Theme) ===== */
#tableWidget_2 {
    background-color: #f5f9ff; /* soft blue-white background */
    alternate-background-color: #e8f1ff;
    gridline-color: #b7c9f0;
  
    
    font: 11pt &quot;Segoe UI&quot;;
    color: #2f3e55;
    selection-background-color: #6ea6f8;
    selection-color: white;
    outline: none;
}

/* ===== Header Styling ===== */
#tableWidget_2 QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #cbd9f6, stop:1 #a9c4f2);
    color: #1d2b4d;
    font-weight: 600;
    font-size: 11pt;
    border: 1px solid #9bb8ef;
  
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

/* ===== Hover effect on header ===== */
#tableWidget_2 QHeaderView::section:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #a6c5ff, stop:1 #8db4ff);
    color: #ffffff;
}

/* ===== Row Hover Highlight ===== */
#tableWidget_2::item:hover {
    background-color: #c8ddff;
    color: #12294d;
}

/* ===== Selected Cell ===== */
#tableWidget_2::item:selected {
    background-color: #7aa3e6;
    color: white;
}

/* ===== Vertical Scrollbar ===== */
#tableWidget_2 QScrollBar:vertical {
    border: none;
    background: #ebf2ff;
    width: 10px;
    margin: 2px 0 2px 0;
    border-radius: 4px;
}

#tableWidget_2 QScrollBar::handle:vertical {
    background: #5077ba;
    border-radius: 4px;
}

#tableWidget_2 QScrollBar::handle:vertical:hover {
    background: #496baa;
}

#tableWidget_2 QScrollBar::add-line:vertical,
#tableWidget_2 QScrollBar::sub-line:vertical {
    height: 0;
}

/* ===== Horizontal Scrollbar ===== */
#tableWidget_2 QScrollBar:horizontal {
    border: none;
    background: #ebf2ff;
    height: 10px;
    margin: 0 2px 0 2px;
    border-radius: 4px;
}

#tableWidget_2 QScrollBar::handle:horizontal {
    background: #90b4ff;
    border-radius: 4px;
}

#tableWidget_2 QScrollBar::handle:horizontal:hover {
    background: #6e9fff;
}

#tableWidget_2 QScrollBar::add-line:horizontal,
#tableWidget_2 QScrollBar::sub-line:horizontal {
    width: 0;
}


/* This styles the empty area (the viewport) */
#tableWidget_2 QTableCornerButton::section,
#tableWidget_2 QTableView QTableCornerButton::section,
#tableWidget_2 QWidget {
    background-color: #94b2e3; /* soft blue empty area */
}

/* The actual viewport region where no cells exist */
#tableWidget_2 QTableView {
    background-color: #94b2e3; /* fill the empty space blue */
}

</string>
