                 <item>
                  <widget class="QTableWidget" name="table_item_table">
                   <property name="minimumSize">
                    <size>
                     <width>0</width>
                     <height>274</height>
                    </size>
                   </property>
                   <property name="layoutDirection">
                    <enum>Qt::LayoutDirection::LeftToRight</enum>
                   </property>
                   <property name="styleSheet">
                    <string notr="true">/* ===== Table Widget Style (Light Blue Theme) ===== */
#table_item_table {
    background-color: #f7f7f7; /* soft blue-white background */
    alternate-background-color: #e8f1ff;
    gridline-color: #b7c9f0;
  
    
    font: 10pt &quot;Segoe UI&quot;;
    color: black;
    selection-background-color: #6ea6f8;
    selection-color: white;
 border: 1px solid #e6e6e6;
   
}

/* ===== Header Styling ===== */
#table_item_table QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ebebeb, stop:1 #ffffff);
    color: #1d2b4d;
    font-weight: 600;
    font-size: 10pt;
    border: 1px solid #9bb8ef;
 
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

/* ===== Hover effect on header ===== */
#table_item_table QHeaderView::section:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #a6c5ff, stop:1 #8db4ff);
    color: black;
}

/* ===== Row Hover Highlight ===== */
#table_item_table::item:hover {
    background-color: #c8ddff;
    color: #12294d;
}

/* ===== Selected Cell ===== */
#table_item_table::item:selected {
    background-color: #7aa3e6;
    color: black;
}

/* ===== Vertical Scrollbar ===== */
#table_item_table QScrollBar:vertical {
    border: none;
    background: #ebf2ff;
    width: 10px;
    margin: 2px 0 2px 0;
    border-radius: 4px;
}

#table_item_table QScrollBar::handle:vertical {
    background: #5077ba;
    border-radius: 4px;
}

#table_item_table QScrollBar::handle:vertical:hover {
    background: #496baa;
}

#table_item_table QScrollBar::add-line:vertical,
#table_item_table QScrollBar::sub-line:vertical {
    height: 0;
}

/* ===== Horizontal Scrollbar ===== */
#table_item_table QScrollBar:horizontal {
    border: none;
    background: #ebf2ff;
    height: 10px;
    margin: 0 2px 0 2px;
    border-radius: 4px;
}

#table_item_table QScrollBar::handle:horizontal {
    background: #90b4ff;
    border-radius: 4px;
}

#table_item_table QScrollBar::handle:horizontal:hover {
    background: #6e9fff;
}

#table_item_table QScrollBar::add-line:horizontal,
#table_item_table QScrollBar::sub-line:horizontal {
    width: 0;
}
</string>
                   </property>
