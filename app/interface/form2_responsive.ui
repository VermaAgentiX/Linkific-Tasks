                     <property name="styleSheet">
                      <string notr="true">


#scrollArea_image_grid {
background-color: #6578b3;
        border: 1px solid #7986ac;
    border-radius: 5px;



}

/* Scrollbar styling for a clean, modern look */
#scrollArea_image_grid QScrollBar:vertical {
    background: #a5bbe6;
    width: 10px;
    margin: 2px;
    border-radius: 5px;
}

#scrollArea_image_grid QScrollBar::handle:vertical {
     background: #5077ba;
    border-radius: 4px;
}

#scrollArea_image_grid QScrollBar::handle:vertical:hover {
    background: #496baa;
}

#scrollArea_image_grid QScrollBar::add-line:vertical,
#scrollArea_image_grid QScrollBar::sub-line:vertical {
    background: none;
    border: none;
}

#scrollArea_image_grid QScrollBar:horizontal {
    background: #a5bbe6;
    height: 10px;
    margin: 2px;
    border-radius: 5px;
}

#scrollArea_image_grid QScrollBar::handle:horizontal {
    background: #6c7cb0;
    border-radius: 5px;
}

#scrollArea_image_grid QScrollBar::handle:horizontal:hover {
    background: #4e5e9e;
}

#scrollArea_image_grid QScrollBar::add-line:horizontal,
#scrollArea_image_grid QScrollBar::sub-line:horizontal {
    background: none;
    border: none;
}
</string>
