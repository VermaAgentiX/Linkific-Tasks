                    <item>
                     <widget class="QComboBox" name="comboBox_5">
                      <property name="minimumSize">
                       <size>
                        <width>150</width>
                        <height>30</height>
                       </size>
                      </property>
                      <property name="maximumSize">
                       <size>
                        <width>150</width>
                        <height>30</height>
                       </size>
                      </property>
                      <property name="font">
                       <font>
                        <family>Segoe UI</family>
                        <pointsize>11</pointsize>
                        <italic>false</italic>
                        <bold>false</bold>
                       </font>
                      </property>
                      <property name="styleSheet">
                       <string notr="true">/* ==========================
   QComboBox - Professional Soft Blue Theme
   ========================== */

QComboBox {
    background-color: #f4f6fb;
    color: #1f2937;
    border: 1px solid #a7b4d0;
    border-radius: 6px;
    padding: 4px 8px;
    font: 11pt &quot;Segoe UI&quot;;
    selection-background-color: #5e85d7;
    selection-color: white;
}

/* Hover effect */
QComboBox:hover {
    background-color: #f0f4ff;
    border: 1px solid #5e85d7;
}

/* Focus (active) effect */
QComboBox:focus {
    background-color: #ffffff;
    border: 2px solid #5e85d7;
    color: #000000;
}

/* Disabled state */
QComboBox:disabled {
    background-color: #e0e0e0;
    color: #7a7a7a;
    border: 1px solid #c0c0c0;
}

/* Drop-down arrow area */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border-left: 1px solid #a7b4d0;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #e8ecf9, stop:1 #cfd8f3);
}

/* Arrow icon (uses system default if custom not available) */
QComboBox::down-arrow {
    image: url(:/icons/down_arrow.png);
    width: 12px;
    height: 12px;
}

/* === Drop-down List Styling === */
QComboBox QAbstractItemView {
    background-color: #f9faff;
    color: #1f2937;
    border: 1px solid #5e85d7;
    border-radius: 6px;
    selection-background-color: #5e85d7;
    selection-color: #ffffff;
    outline: none;
    padding: 2px;
}

/* Hover over individual items */
QComboBox QAbstractItemView::item:hover {
    background-color: #dbe6ff; /* Soft blue hover */
    color: #1f2937;
}

/* Selected item (click or keyboard highlight) */
QComboBox QAbstractItemView::item:selected {
    background-color: #5e85d7;
    color: #ffffff;
    border-radius: 3px;
}
</string>
