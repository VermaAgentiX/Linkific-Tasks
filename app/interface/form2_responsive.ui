             </size>
            </property>
            <property name="styleSheet">
             <string notr="true">/* Main Tab Widget */
#tabWidget::pane {
    
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #edf2f7, stop:1 #dce4f2);
   
   
    
}

/* Tabs - neutral background, rounded, soft hover */
#tabWidget QTabBar::tab {
    background-color: #5165a6; /* Dark Blue */
    color: white;
    padding: 2px 6px;
    margin-right: 6px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    font: 10pt &quot;Segoe UI&quot;;
    font-weight: 500;
    min-width: 100px;
    border: 1px solid #a7b4d0;
    border-bottom: none;
   
}

/* Selected tab - highlighted cleanly with shadow and bolder color */
#tabWidget QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #a6c8ff, stop:1 #94b2e3);
    color: white;
    border: 1px solid #96b4e6;
border-bottom: 1px solid #96b4e6;;
    font-weight: 600;
 font: 11pt &quot;Segoe UI&quot;;
   
}

/* Hover (for non-selected tabs) - subtle lightening */
#tabWidget QTabBar::tab:hover:!selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #7c9bf1, stop:1 #7c9bf1);
    color: white;
    border: 1px solid #9fb0d6;
}

/* TabBar base */
#tabWidget QTabBar {
    qproperty-drawBase: 0;
  
}


#tabWidget QWidget {
    background-color: #c4dcff;
}
</string>
            </property>
            <property name="tabPosition">
             <enum>QTabWidget::TabPosition::North</enum>
            </property>
            <property name="tabShape">
             <enum>QTabWidget::TabShape::Rounded</enum>
            </property>
            <property name="currentIndex">
             <number>0</number>
            </property>
            <property name="documentMode">
             <bool>true</bool>
            </property>
            <widget class="QWidget" name="tab">
             <attribute name="title">
              <string>Calender</string>
             </attribute>
             <layout class="QHBoxLayout" name="horizontalLayout">
              <property name="leftMargin">
               <number>0</number>
              </property>
