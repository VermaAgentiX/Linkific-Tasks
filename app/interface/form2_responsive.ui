                      <property name="styleSheet">
                       <string notr="true">#listWidget_stock_list {
    background-color: #eaf1fb;
    border: 1px solid #b0c4de;
    border-radius: 0px;
    padding: 4px;
  
    color: #1a1a1a;
    outline: none;
}

/* Scrollbar styling */
#listWidget_stock_list QScrollBar:vertical {
    border: none;
    background: #c4dcff;
    width: 10px;
    border-radius: 5px;
}

#listWidget_stock_list QScrollBar::handle:vertical {
    background: #5077ba;
    min-height: 20px;
    border-radius: 5px;
}

#listWidget_stock_list QScrollBar::handle:vertical:hover {
    background: #486da8;
}

#listWidget_stock_list QScrollBar::add-line:vertical,
#listWidget_stock_list QScrollBar::sub-line:vertical {
    height: 0;
}

/* List item styling */
#listWidget_stock_list::item {
    padding: 4px;
    border-radius: 4px;
}

#listWidget_stock_list::item:selected {
    background-color: #81a6e1;
    color: white;
}

#listWidget_stock_list::item:hover {
    background-color: #c4dcff;
color: black;
}
</string>
