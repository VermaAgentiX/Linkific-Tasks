                    <item>
                     <widget class="QTableWidget" name="tableWidget_item_table">
                      <property name="font">
                       <font>
                        <family>Segoe UI</family>
                        <pointsize>11</pointsize>
                        <italic>false</italic>
                        <bold>false</bold>
                       </font>
                      </property>
                      <property name="styleSheet">
                       <string notr="true">/* ===== Table Widget Style (Light Blue Theme) ===== */
#tableWidget_item_table {
    background-color: #f5f9ff; /* soft blue-white background */
    alternate-background-color: #e8f1ff;
    gridline-color: #b7c9f0;
  
    
    font: 11pt &quot;Segoe UI&quot;;
    color: #2f3e55;
    selection-background-color: #6ea6f8;
    selection-color: white;
    outline: none;
}

/* ===== Header Styling ===== */
#tableWidget_item_table QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #cbd9f6, stop:1 #a9c4f2);
    color: #1d2b4d;
    font-weight: 600;
    font-size: 11pt;
    border: 1px solid #9bb8ef;
  
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

/* ===== Hover effect on header ===== */
#tableWidget_item_table QHeaderView::section:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #a6c5ff, stop:1 #8db4ff);
    color: #ffffff;
}

/* ===== Row Hover Highlight ===== */
#tableWidget_item_table::item:hover {
    background-color: #c8ddff;
    color: #12294d;
}

/* ===== Selected Cell ===== */
#tableWidget_item_table::item:selected {
    background-color: #7aa3e6;
    color: white;
}

/* ===== Vertical Scrollbar ===== */
#tableWidget_item_table QScrollBar:vertical {
    border: none;
    background: #ebf2ff;
    width: 10px;
    margin: 2px 0 2px 0;
    border-radius: 4px;
}

#tableWidget_item_table QScrollBar::handle:vertical {
    background: #5077ba;
    border-radius: 4px;
}

#tableWidget_item_table QScrollBar::handle:vertical:hover {
    background: #496baa;
}

#tableWidget_item_table QScrollBar::add-line:vertical,
#tableWidget_item_table QScrollBar::sub-line:vertical {
    height: 0;
}

/* ===== Horizontal Scrollbar ===== */
#tableWidget_item_table QScrollBar:horizontal {
    border: none;
    background: #ebf2ff;
    height: 10px;
    margin: 0 2px 0 2px;
    border-radius: 4px;
}

#tableWidget_item_table QScrollBar::handle:horizontal {
    background: #90b4ff;
    border-radius: 4px;
}

#tableWidget_item_table QScrollBar::handle:horizontal:hover {
    background: #6e9fff;
}

#tableWidget_item_table QScrollBar::add-line:horizontal,
#tableWidget_item_table QScrollBar::sub-line:horizontal {
    width: 0;
}


/* This styles the empty area (the viewport) */
#tableWidget_item_table QTableCornerButton::section,
#tableWidget_item_table QTableView QTableCornerButton::section,
#tableWidget_item_table QWidget {
    background-color: #94b2e3; /* soft blue empty area */
}

/* The actual viewport region where no cells exist */
#tableWidget_item_table QTableView {
    background-color: #94b2e3; /* fill the empty space blue */
}

</string>
                      </property>
