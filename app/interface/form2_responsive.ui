                <property name="styleSheet">
                 <string notr="true">
#widget_5 {
    
	background-color: rgb(148, 178, 227);
    border: 1px solid #94b2e3;
       border-top-left-radius: 0px;   /* No radius on top-left */
    border-top-right-radius: 8px;  /* Rounded */
    border-bottom-left-radius: 8px; /* Rounded */
    border-bottom-right-radius: 8px; /* Rounded */
}

/* Add subtle shadow feel */
#widget_5:hover {
        background-color: #81a6e1;
    border: 1px solid #4e8df5;
       border-top-left-radius: 0px;   /* No radius on top-left */
    border-top-right-radius: 8px;  /* Rounded */
    border-bottom-left-radius: 8px; /* Rounded */
    border-bottom-right-radius: 8px; /* Rounded */
}

/* Optional focus / active effect */
#widget_5:focus {
    border: 2px solid #2b6ef3;
    background-color: #ffffff;
   border-top-left-radius: 0px;   /* No radius on top-left */
    border-top-right-radius: 8px;  /* Rounded */
    border-bottom-left-radius: 8px; /* Rounded */
    border-bottom-right-radius: 8px; /* Rounded */
}
</string>
