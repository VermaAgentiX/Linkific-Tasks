# Copy to .env and fill in local values. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:URL_ENCODED_PASSWORD@localhost:5432/student_record_manager
JWT_SECRET_KEY=generate-a-unique-random-secret
JWT_EXPIRE_MINUTES=60
# Optional comma-separated admin emails. Set before registering the admin account.
ADMIN_EMAILS=admin@example.com
